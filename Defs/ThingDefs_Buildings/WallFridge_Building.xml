<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<ThingDef Name="WallFridgeBase" ParentName="FridgeBase" Abstract="True">
		<thingClass>RimFridge.RimFridge_WallBuilding</thingClass>
		<designatorDropdown>WallFridgeDesignatorDropdownDef</designatorDropdown>
		<passability>Impassable</passability>
		<blockWind>true</blockWind>
		<staticSunShadowHeight>1.0</staticSunShadowHeight>
		<fillPercent>1</fillPercent>
		<coversFloor>true</coversFloor>
		<blockLight>true</blockLight>
		<drawStyleCategory>Walls</drawStyleCategory>
		<canOverlapZones>false</canOverlapZones>
		<holdsRoof>true</holdsRoof>
		<terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
		<building>
			<isWall>true</isWall>
			<ai_chillDestination>true</ai_chillDestination>
			<canPlaceOverWall>true</canPlaceOverWall>
		</building>
	</ThingDef>

	<ThingDef ParentName="WallFridgeBase">
		<defName>RimFridge_SingleWallRefrigerator</defName>
		<thingClass>RimFridge.RimFridge_DoubleSidedWallBuilding</thingClass>
		<label>Wall Single Refrigerator</label>
		<graphicData>
			<texPath>Building/Temperature/Fridge/WallSingleFridge</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(1,1)</drawSize>
		</graphicData>
		<costList>
			<Steel>20</Steel>
			<ComponentIndustrial>1</ComponentIndustrial>
		</costList>
		<statBases>
			<Mass>15</Mass>
			<MaxHitPoints>100</MaxHitPoints>
			<WorkToBuild>750</WorkToBuild>
			<Flammability>1.0</Flammability>
		</statBases>
		<size>(1,1)</size>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>70</basePowerConsumption>
				<powerUpgrades>
					<li>
						<researchProject>RimFridge_PowerFactorSetting</researchProject>
						<factor>1.0</factor>
					</li>
				</powerUpgrades>
			</li>
			<li Class="RimFridge.CompProperties_SecondLayer">
				<graphicData>
					<texPath>Building/Temperature/Fridge/WallSingleFridgeLid</texPath>
					<graphicClass>Graphic_Multi</graphicClass>
					<shaderType>Transparent</shaderType>
					<drawSize>(1,1)</drawSize>
				</graphicData>
				<altitudeLayer>Projectile</altitudeLayer>
			</li>
		</comps>
		<building>
			<groupingLabel>Wall Single Refrigerator</groupingLabel>
		</building>
	</ThingDef>

	<ThingDef ParentName="WallFridgeBase">
		<defName>RimFridge_WallRefrigerator</defName>
		<thingClass>RimFridge.RimFridge_DoubleSidedWallBuilding</thingClass>
		<label>Wall Dual Refrigerator</label>
		<graphicData>
			<texPath>Building/Temperature/Fridge/WallDualFridge</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(2,1)</drawSize>
		</graphicData>
		<costList>
			<Steel>40</Steel>
			<ComponentIndustrial>1</ComponentIndustrial>
		</costList>
		<statBases>
			<Mass>30</Mass>
			<MaxHitPoints>100</MaxHitPoints>
			<WorkToBuild>1050</WorkToBuild>
			<Flammability>1.0</Flammability>
		</statBases>
		<size>(2,1)</size>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>100</basePowerConsumption>
				<powerUpgrades>
					<li>
						<researchProject>RimFridge_PowerFactorSetting</researchProject>
						<factor>1.0</factor>
					</li>
				</powerUpgrades>
			</li>
			<li Class="RimFridge.CompProperties_SecondLayer">
				<graphicData>
					<texPath>Building/Temperature/Fridge/WallDualFridgeLid</texPath>
					<graphicClass>Graphic_Multi</graphicClass>
					<shaderType>Transparent</shaderType>
					<drawSize>(2,1)</drawSize>
				</graphicData>
				<altitudeLayer>Projectile</altitudeLayer>
			</li>
		</comps>
		<building>
			<groupingLabel>Wall Dual Refrigerator</groupingLabel>
		</building>
	</ThingDef>
</Defs>
